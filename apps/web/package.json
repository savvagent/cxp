{
  "name": "@cxp/web",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "pnpm run paraglide:compile && vite dev",
    "build": "pnpm run paraglide:compile && pnpm run check:messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build && node scripts/extract-inline-scripts.mjs",
    "preview": "vite preview",
    "check": "pnpm run paraglide:compile && pnpm run check:messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm run paraglide:compile && vitest run",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "check:messages": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.69.0",
    "@savvagent/console-ui": "0.2.0",
    "@tanstack/svelte-query": "^6.3.9",
    "@vite-pwa/workbox-swkit": "^8.0.13",
    "@vite-pwa/workbox-window": "^8.0.13",
    "svelte-sonner": "^1.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.0.0",
    "@unplugin-pwa/core": "0.0.3",
    "@vite-pwa/sveltekit": "^2.0.0",
    "magicast": "^0.5.5",
    "rolldown": "^1.2.16",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
